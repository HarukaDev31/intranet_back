# Overlay QA (NO se commitea: ver .gitignore → docker-compose.qa.yml)
#
# En el servidor QA:
#   cp docker-compose.qa.yml.example docker-compose.qa.yml
#   docker compose -f docker-compose.yml -f docker-compose.qa.yml up -d --build
#
# .env típico QA:
#   APP_PORT=8085
#   APP_URL=https://qa.intranetback.probusiness.pe
#   DB_HOST=localhost
#   DB_SOCKET=/opt/mysql-socket/mysqld.sock
#   MYSQL_SOCKET_DIR_HOST=/opt/mysql-socket
#   DOCKER_REDIS_HOST=redis
#   FORWARD_REDIS_PORT=6380
#   REDIS_PREFIX=qa_
#   LARAVEL_WEBSOCKETS_PORT=6002
#   PUSHER_PORT=6002
#   HORIZON_PREFIX=qa_horizon:
#
# MySQL: socket en /opt/mysql-socket (persistente). No uses /run/mysqld:
# systemd recrea ese dir en cada restart y el bind mount de Docker queda stale.

name: intranet_back_qa

services:
  redis:
    ports:
      - "127.0.0.1:${FORWARD_REDIS_PORT:-6380}:6379"

  app:
    volumes:
      - ${MYSQL_SOCKET_DIR_HOST:-/opt/mysql-socket}:/opt/mysql-socket

  horizon:
    volumes:
      - ${MYSQL_SOCKET_DIR_HOST:-/opt/mysql-socket}:/opt/mysql-socket

  scheduler:
    volumes:
      - ${MYSQL_SOCKET_DIR_HOST:-/opt/mysql-socket}:/opt/mysql-socket

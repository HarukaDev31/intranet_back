# Overlay PROD (NO se commitea: ver .gitignore → docker-compose.prod.yml)
#
# En el servidor PROD:
#   cp docker-compose.prod.yml.example docker-compose.prod.yml
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# .env típico PROD:
#   APP_PORT=8082
#   COMPOSE_PROJECT_NAME=intranet_back
#   APP_ENV=production
#   APP_DEBUG=false
#   DB_HOST=localhost
#   DB_SOCKET=/opt/mysql-socket/mysqld.sock
#   MYSQL_SOCKET_DIR_HOST=/opt/mysql-socket
#   DOCKER_REDIS_HOST=redis
#   FORWARD_REDIS_PORT=6381
#   REDIS_PREFIX=intranet_back_
#   LARAVEL_WEBSOCKETS_PORT=6001
#   HORIZON_PREFIX=intranet_horizon:
#
# MySQL: socket en /opt/mysql-socket (persistente). No uses /run/mysqld:
# systemd recrea ese dir en cada restart y el bind mount de Docker queda stale.

name: intranet_back

services:
  redis:
    ports:
      - "127.0.0.1:${FORWARD_REDIS_PORT:-6381}:6379"

  app:
    volumes:
      - ${MYSQL_SOCKET_DIR_HOST:-/opt/mysql-socket}:/opt/mysql-socket

  horizon:
    volumes:
      - ${MYSQL_SOCKET_DIR_HOST:-/opt/mysql-socket}:/opt/mysql-socket

  scheduler:
    volumes:
      - ${MYSQL_SOCKET_DIR_HOST:-/opt/mysql-socket}:/opt/mysql-socket
